{
  "name": "dsh-problem-bank",
  "version": "0.5.12",
  "description": "Token-efficient math problem bank with technique-driven innovation for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "SYSTEM_PROMPT.md",
    "icon.png"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-seed.mjs",
    "test:eng": "node scripts/eng-smoke.mjs",
    "test:integration": "node scripts/integration-smoke.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "test:gate": "node scripts/variation-gate-smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "problem-bank",
    "education",
    "math",
    "technique",
    "mock-exam"
  ],
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyans2022/dsh-problem-bank.git"
  },
  "homepage": "https://github.com/ziyans2022/dsh-problem-bank#readme",
  "bugs": {
    "url": "https://github.com/ziyans2022/dsh-problem-bank/issues"
  }
}
