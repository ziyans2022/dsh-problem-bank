          "type": "boolean",
          "description": "是否要求多知识点在关键一步耦合"
        }
      },
      "required": [
        "id",
        "patternId",
        "keyMoves",
        "conditionStructure",
        "answerType"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "patternId": {
          "type": "string"
        },
        "keyMoves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answerType": {
          "type": "string"
        }
      }
    }
  },
