        }
      },
      "required": [
        "id",
        "preserved",
        "conditionsCompatible",
        "solutionExists",
        "boundaryChecked",
        "proofComplete"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "nextAction": {
          "type": "string"
        }
      }
    }
  },
