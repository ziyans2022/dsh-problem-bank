  "record_variation_intent": {
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "候选题 id"
        },
        "variationType": {
          "type": "string",
          "description": "original 原始题 / isomorphic 同构（保持深度换表述）/ structural 结构（换结构保思想）/ harder 增难（新增障碍）/ extension 拓展（推广或研究边界）/ simplified 降难（不计为创新，默认禁止）",
          "enum": [
            "original",
            "isomorphic",
            "structural",
            "harder",
            "extension",
            "simplified"
          ]
        },
        "originalProblemId": {
          "type": "string",
          "description": "原题 id（非 original 必填）"
        },
        "target": {
          "type": "string",
          "description": "本次变式目标：保持难度 / 增加难度 / 结构迁移 / 推广"
        },
        "coreClaim": {
          "type": "string",
          "description": "核心结论"
        },
        "keyTechniques": {
          "type": "array",
          "description": "关键技巧（Technique id 或一句话）",
          "items": {
            "type": "string"
          }
        },
        "hardestStep": {
          "type": "string",
          "description": "最难的一步：要想到什么（不要只写步数）"
        },
        "generality": {
          "type": "string",
          "description": "一般性：general-n 对任意 n / finite-case 有限情形 / single-instance 单例",
          "enum": [
            "general-n",
            "finite-case",
            "single-instance"
          ]
        },
        "proofObligations": {
          "type": "array",
          "description": "必须完成的证明义务",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "variationType",
        "coreClaim",
        "hardestStep",
        "generality"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "variationType": {
          "type": "string"
        },
        "originalProblemId": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "generality": {
          "type": "string"
        },
        "originalGenerality": {
          "type": "string"
        }
      }
    }
  },
  "audit_variation": {
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "preserved": {
          "type": "array",
          "description": "保留了什么核心难点（至少一条，要具体）",
          "items": {
            "type": "string"
          }
        },
        "added": {
          "type": "array",
          "description": "新增了什么推理障碍（harder/structural/extension 必填）",
          "items": {
            "type": "string"
          }
        },
        "weakened": {
          "type": "array",
          "description": "削弱了什么（非 simplified 必须为空）",
          "items": {
            "type": "string"
          }
        },
        "conditionsCompatible": {
          "type": "boolean"
        },
        "solutionExists": {
          "type": "boolean"
